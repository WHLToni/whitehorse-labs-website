{
  "name": "SpecialistEnquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "practice_name": {
      "type": "string",
      "title": "Practice Name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "Specialist",
        "Practice manager",
        "Other"
      ]
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "message": {
      "type": "string",
      "title": "Message"
    }
  },
  "required": [
    "name",
    "practice_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}